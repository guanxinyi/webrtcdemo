# Copy to deploy/.env and change the secret before exposing the service.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# URL returned to clients. Use a reachable address:
#   same machine      -> ws://localhost:7880
#   Android emulator  -> ws://10.0.2.2:7880
#   phones on LAN     -> ws://192.168.x.x:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Comma separated allowed origins for the Token API, or * for any.
CORS_ORIGIN=*
TOKEN_TTL_SECONDS=3600

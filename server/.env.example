# Port of the token API
PORT=8080

# WebSocket URL that clients connect to (must be reachable from the app)
LIVEKIT_URL=ws://localhost:7880
# HTTP URL used by this server to call LiveKit's RoomService API.
# Defaults to LIVEKIT_URL with ws->http.
# LIVEKIT_HTTP_URL=http://localhost:7880
# Optional URL returned to clients when it differs from LIVEKIT_URL
# LIVEKIT_PUBLIC_URL=wss://livekit.example.com

# Must match the keys configured in LiveKit server (deploy/livekit.yaml)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Access token lifetime in seconds
TOKEN_TTL_SECONDS=3600

# Comma separated list of allowed origins, or * for any
CORS_ORIGIN=*
